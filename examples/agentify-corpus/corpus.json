{
  "schemaVersion": "0.1",
  "description": "Classification metadata for real-world Agentify crawl corpus entries.",
  "entries": [
    {
      "id": "good-static-site",
      "sourceUrl": "https://www.iana.org/domains/reserved",
      "label": "Good static site",
      "category": "static-site",
      "classification": {
        "machineReadability": "medium",
        "requiresJavascript": false,
        "requiresAuthentication": false,
        "crawlability": "complete",
        "metadataQuality": "partial",
        "discoveryQuality": "partial"
      },
      "expectations": {
        "crawlStatus": "complete",
        "minFetched": 2,
        "diagnosticCodes": [
          "missing.description"
        ],
        "robotsStatus": "fetched",
        "sitemapStatus": "unavailable"
      },
      "notes": "Stable public HTML with multiple observable routes, but missing descriptions reduce semantic quality."
    },
    {
      "id": "protected-site",
      "sourceUrl": "https://app.asana.com/",
      "label": "Protected site",
      "category": "defensive-infra",
      "classification": {
        "machineReadability": "low",
        "requiresJavascript": null,
        "requiresAuthentication": true,
        "crawlability": "blocked",
        "metadataQuality": "unknown",
        "discoveryQuality": "partial"
      },
      "expectations": {
